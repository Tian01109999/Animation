{
  "version": 1,
  "doc": "Định nghĩa overlay (khớp schema.OverlayKind + Overlay.data). Kích thước: phân số của W/H khung đầu ra. title/subtitle = trường của Overlay; data = Overlay.data (khoá tuỳ chọn, có mặc định). anchor: tl|tr|bl|br|center|left_mid|character. anim: in/out. Tất cả vẽ sau grade (không chỉnh màu), font Be Vietnam Pro, NFC. Xem docs/STYLE_GUIDE.md §9.",
  "fonts": {"bold": "BeVietnamPro-Bold", "semibold": "BeVietnamPro-SemiBold", "hand": "BeVietnamPro-Italic"},
  "overlays": {
    "subtitle": {
      "implicit": true, "anchor": "bottom_center",
      "params": {"baseline_y": 0.89, "size_h": 0.044, "color": "#ffffff", "stroke": "#000000", "stroke_w_h": 0.003, "shadow_blur_h": 0.008, "shadow_alpha": 0.7, "max_lines": 1, "words_per_chunk": [2, 6], "box": false},
      "notes": "Không phải OverlayKind; lấy từ Shot.subtitle/lines. Luôn vẽ trên cùng."
    },
    "nametag": {
      "anchor": "character", "anim": {"in": "fade 0.3", "out": "fade 0.3"},
      "params": {"bg": "#f4eddf", "dot": "#3cb44b", "name_size_h": 0.03, "role_size_h": 0.02, "role_color": "#7a7a7a", "radius_h": 0.012},
      "fields": {"title": "tên", "subtitle": "vai trò", "character_id": "neo"}
    },
    "badge": {
      "anchor": "character_chest", "anim": {"in": "none"},
      "params": {"bg": "#ffffff", "text_color": "#7a2a2a", "w_char": 0.11, "h_char": 0.035, "side": "left_chest"},
      "fields": {"title": "chữ trên bảng tên", "character_id": "bắt buộc"},
      "data": {"text": "str (mặc định = title)", "color": "hex nền bảng tên", "emblem": "leaf | star4 | none"},
      "notes": "Vẽ như một phần áo, gắn xương torso, chịu chỉnh màu của nhân vật (ngoại lệ duy nhất)."
    },
    "location_card": {"anchor": "tl", "params": {"bg": "#5b1f1a", "border": "#d9b48a", "dot": "#d0302a"}, "fields": {"title": "địa điểm", "subtitle": "phụ"}},
    "time_card": {"anchor": "tl", "params": {"bg": "#5b1f1a", "border": "#d9b48a", "dot": "#d0302a"}, "fields": {"title": "giờ", "subtitle": "phụ"}},
    "chapter_card": {
      "anchor": "center", "params": {"bg": "#14110f", "border": "#d8ab3a", "number_box": "#d0302a", "subtitle_color": "#f3c94e"},
      "data": {"style": "board | text_on_black"}
    },
    "rule_card": {
      "anchor": "tl", "anim": {"in": "slide_down 0.35", "out": "fade 0.3"},
      "params": {"w": 0.30, "h": 0.24, "paper": "#f6efdf", "lines": "#a9c4e0", "margin_bar": "#d0302a", "margin_bar_w": 0.006, "text_color": "#1f2f5a", "text_size_h": 0.035, "keyword_color": "#d0302a", "pill_bg": "#151517", "pill_dot": "#d0302a", "warn_icon": "#f3c94e", "radius_h": 0.012},
      "fields": {"title": "nội dung luật (từ khoá *...*)", "subtitle": "nhãn, vd 'Luật số 3'"},
      "data": {"number": "int", "corner": "tl | tr", "caption_en": "str dòng phụ IN HOA"}
    },
    "rule_list": {
      "anchor": "center", "anim": {"in": "fade 0.4", "camera": "pan_down_slow"},
      "params": {"paper": "#f3ead6", "lines": "#a9c4e0", "margin": "#d0302a", "ink": "#1f3f8a", "red_ink": "#c8352e", "tape": "#e2d3b0", "rotation_deg": -2, "w": 0.56, "h": 0.92},
      "fields": {"title": "tiêu đề tờ luật", "subtitle": "ghi chú trong ngoặc"},
      "data": {"rules": "list[str]", "red_index": "int | null", "redact_last": "bool", "blurred": "bool", "hands": "bool", "coffee_stain": "bool", "bleed_through": "bool"}
    },
    "cctv": {
      "anchor": "fullframe", "anim": {"rec_blink_hz": 1.0, "seconds_tick": true},
      "params": {"rec_dot": "#e0262b", "rec_size_h": 0.033, "label_size_h": 0.02, "timestamp_size_h": 0.03, "timestamp_color": "#e6e8ea",
                 "counter_box": {"w": 0.14, "h": 0.12, "bg": "#0b0c0e", "bg_alpha": 0.85, "border": "#d9dde2", "radius_px": 8, "number_size_h": 0.074},
                 "grid_gutter_px": 4},
      "fields": {"title": "nhãn camera, vd 'CAM 3 · Lối kệ 3'", "subtitle": "tuỳ chọn"},
      "data": {
        "cam": "int (1)",
        "label": "str vị trí",
        "timestamp": "str 'DD-MM-YYYY HH:MM:SS' bắt đầu",
        "tick": "bool (giây chạy theo thời gian shot)",
        "people": "int | null (hộp đếm người)",
        "people_label": "str ('SỐ NGƯỜI TRONG CỬA HÀNG')",
        "people_emphasis": "bool (phóng hộp đếm ra giữa ×2.5, blur nền)",
        "grid": "1 | 4",
        "cells": "list[{cam:int, label:str, location:str|null}] cho grid 4",
        "split": "null | {left_tag:'trên camera', right_tag:'bằng mắt thường', right_location:str}"
      },
      "notes": "Thường đi kèm Shot.effects=['cctv']. Với grid 4, compositor render 4 plate nhỏ (location của mỗi cell, mặc định = shot.location)."
    },
    "phone_chat": {
      "anchor": "center", "anim": {"in": "rise 0.3", "messages": "pop từng tin 0.5s"},
      "params": {"phone_h": 0.86, "bezel": "#0b0b0d", "screen": "#101114", "bubble_in": "#3a3b40", "bubble_out": "#2e7cf6", "text": "#ffffff"},
      "fields": {"title": "tên liên hệ", "subtitle": "trạng thái"},
      "data": {"time": "str", "messages": "list[{from:'me'|'them', text:str}]", "hand": "bool", "lock_screen": "bool", "notification": "{sender,text} khi lock_screen"}
    },
    "phone_bank": {
      "anchor": "center",
      "params": {"phone_h": 0.86, "header_from": "#1e5fd0", "header_to": "#3aa0f0", "neg": "#d0302a", "pos": "#2f9a4a"},
      "fields": {"title": "tên ngân hàng hư cấu", "subtitle": "tên tài khoản"},
      "data": {"balance": "str", "account_masked": "str", "transactions": "list[{label:str, amount:str, date:str|null}]", "hand": "bool"}
    },
    "missing_poster": {
      "anchor": "center", "anim": {"in": "fade 0.3", "camera": "push_in_slow"},
      "params": {"w": 0.42, "h": 0.84, "paper": "#f4f1ea", "header": "#c8352e", "header_text": "#ffffff", "tape": "#e2d3b0"},
      "fields": {"title": "họ tên", "subtitle": "tuổi"},
      "data": {"header": "str ('TÌM NGƯỜI MẤT TÍCH')", "desc": "str", "datetime": "str (đỏ)", "phone": "str (che số)", "photo": "archetype:<id> | character:<id> | blank", "variant": "clean | torn | crumpled | wall"}
    },
    "map_card": {
      "anchor": "center",
      "params": {"w": 0.70, "h": 0.74, "paper": "#efe7d4", "road": "#8c8a86", "center_line": "#e3b43a", "water": "#4a86c0", "marker": "#d0302a", "bg": "#1d1f24"},
      "fields": {"title": "tiêu đề", "subtitle": "phụ đề IN HOA nhỏ"},
      "data": {"road_label": "str", "water_label": "str | null", "marker": "{x:0..1, y:0..1, label:str}", "tag": "str | null", "road_path": "list[[x,y]] (mặc định cong ngang)", "water_path": "list[[x,y]] | null"}
    },
    "timeline": {
      "anchor": "fullframe", "anim": {"build": "từng hình 0.35s"},
      "params": {"bg": "#0f1320", "figure": "#2a2b30", "collar": "#d9b44a", "baseline": "#c8352e", "tag": "#efe5d0", "tag_hl": "#c8352e", "progress": "#5a5e68"},
      "fields": {"title": "tiêu đề", "subtitle": "phụ đề IN HOA"},
      "data": {"items": "list[{label:str, highlight:bool}]", "progress_steps": "int (6)", "progress_done": "int"}
    },
    "info_card": {
      "anchor": "left_mid", "anim": {"in": "slide_right 0.3"},
      "params": {"w": 0.31, "h": 0.27, "bg": "#f3ede2", "accent": "#e3b43a", "accent_w_px": 6, "pill_bg": "#151517", "last_row": "#c8352e"},
      "fields": {"title": "nhãn pill, vd 'GIÁ · POS'", "subtitle": "chân thẻ IN HOA"},
      "data": {"rows": "list[{label:str, value:str, note:str|null}]", "emphasis_last": "bool", "blur_bg": "bool"}
    },
    "job_ad": {
      "anchor": "center", "anim": {"in": "drop 0.4", "confetti": "mẩu giấy/băng keo bay"},
      "params": {"w": 0.46, "h": 0.62, "card": "#ffffff", "header": "#e3b43a", "pill": "#c8352e", "rotation_deg": -3},
      "fields": {"title": "tiêu đề tuyển dụng", "subtitle": "giờ làm"},
      "data": {"shop": "str hư cấu", "salary": "str", "footnote": "str"}
    },
    "watermark": {"implicit": true, "anchor": "tr", "notes": "config.yaml > render.watermark"}
  }
}
